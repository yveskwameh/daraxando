# Copy to .dev.vars for local development. Any long random string works.
# Live, each copy has its own, added in the Cloudflare dashboard: the Worker, Settings, Variables and Secrets.
SESSION_SECRET=replace-with-a-long-random-string

# Google sign-in's secret, from Google Cloud (project Dara X&O, Clients, Dara X&O web).
GOOGLE_CLIENT_SECRET=replace-with-the-google-client-secret
# Optional on your Mac: without it, sign-in codes are printed in the terminal instead of emailed.
RESEND_API_KEY=
