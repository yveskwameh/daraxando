{
  // Cloudflare config for the game. The React app is served as static files, and only
  // /api/* runs the Worker in worker/index.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daraxando",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",

  "assets": {
    // Any path that is not a file gets index.html, so /r/K7P2Q opens the app.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // MATCH: one object per match or friend room. MATCHMAKER: one object that pairs players.
  // SQLite-backed, which is what the free plan supports.
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Match" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Match", "Matchmaker"] }],

  // Player profiles, ratings and match history. Before the first deploy, run
  // `npx wrangler d1 create daraxando` and paste the id it prints over the placeholder.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daraxando",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // New players: at most 5 a minute from one phone, and a loose 60 a minute per IP address.
  // Most Nigerian mobile networks put thousands of phones behind one IP, so the IP limit is
  // only a backstop. The phone's id is a random value the app keeps in local storage.
  "ratelimits": [
    { "name": "DEVICE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
