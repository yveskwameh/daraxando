# Cloudflare static asset headers.

# Every page: a strict Content Security Policy and the usual protections.
#  - Scripts, styles, fonts and images come from the game itself. React sets some inline
#    styles, hence 'unsafe-inline' for styles only, never for scripts.
#  - connect-src: the game's own API and its WebSockets.
#  - static.cloudflareinsights.com / cloudflareinsights.com: Cloudflare Web Analytics, once
#    Yves turns it on. Google sign-in is a full-page trip to Google and back, so it needs nothing here.
#  - blob: for confetti, which draws in a worker.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss: https://cloudflareinsights.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Hashed build files never change, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pictures in the sign-in email. Mail apps keep their own copy, so a week is plenty.
/email/*
  Cache-Control: public, max-age=604800

# Google's "Sign in with Google" button, as Google supplies it.
/google/*
  Cache-Control: public, max-age=604800

# The service worker and manifest must always be checked for updates.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
